OPENAI_API_KEY=""
GROQ_API_KEY=""
GOOGLE_API_KEY=""
GPLACES_API_KEY=""
FOURSQUARE_API_KEY=""
TAVILAY_API_KEY=""
OPENWHEATHER_API_KEY=""
EXCHANGE_RATE_API_KEY=""
LANGCHAIN_API_KEY=""

# ============================================================
# AGENTIC AI TRIP PLANNER - API KEYS
# ============================================================

# OpenAI API
# Use case:
# - Main LLM for the trip-planning agent
# - Natural language understanding and generation
# - Reasoning over user preferences, budget, dates, and constraints
# - Can be used to orchestrate multiple specialized travel agents
OPENAI_API_KEY=""


# Groq API
# Use case:
# - Fast LLM inference for agent responses
# - Useful when low-latency responses are required
# - Can be used as an alternative/fallback LLM provider
# - Useful for lightweight agent tasks such as classification,
#   itinerary refinement, and tool-selection decisions
GROQ_API_KEY=""


# Google API
# Use case:
# - Google services that require a Google API key
# - Can support Google-based travel/location services depending
#   on which APIs are enabled in your Google Cloud project
GOOGLE_API_KEY=""


# Google Places API
# Use case:
# - Search for hotels, restaurants, attractions, landmarks,
#   tourist destinations, and other points of interest
# - Retrieve place details such as address, rating, reviews,
#   opening hours, and photos
# - Helps the Trip Planner agent discover real-world places
#   based on the user's travel requirements
GPLACES_API_KEY=""


# Foursquare API
# Use case:
# - Discover places such as restaurants, cafes, attractions,
#   hotels, and other points of interest
# - Provides additional location and venue information
# - Can be used by the Places/Discovery agent as an alternative
#   or complementary source to Google Places
FOURSQUARE_API_KEY=""


# Tavily API
# Use case:
# - Real-time web search for travel information
# - Find current information about destinations, attractions,
#   events, travel restrictions, recommendations, etc.
# - Allows the AI agent to search the web instead of relying
#   only on the LLM's built-in knowledge
# - Useful for a Web Research / Travel Research agent
TAVILY_API_KEY=""


# OpenWeather API
# Use case:
# - Retrieve current weather conditions
# - Get weather forecasts for destinations
# - Helps the Weather Agent determine suitable activities
#   and recommend appropriate travel dates
OPENWEATHER_API_KEY=""


# ExchangeRate API
# Use case:
# - Retrieve current currency exchange rates
# - Convert the user's budget between currencies
# - Helps the Budget/Finance Agent estimate accommodation,
#   food, transportation, and activity costs
EXCHANGE_RATE_API_KEY=""


# LangChain API
# Use case:
# - Connect your application to LangSmith for tracing and observability
# - Monitor agent executions, LLM calls, tool calls, and workflows
# - Debug agent behavior and identify errors
# - Evaluate and improve the performance of your AI trip-planning agents
LANGCHAIN_API_KEY=""